import numpy as np

# Convert features and target to NumPy arrays
X = model_data[feature_columns].to_numpy(dtype=float)
y = model_data[target_column].to_numpy(dtype=float)

# Train-test split
np.random.seed(42)

indices = np.random.permutation(len(X))

split_index = int(0.8 * len(X))

train_indices = indices[:split_index]
test_indices = indices[split_index:]

X_train = X[train_indices]
X_test = X[test_indices]

y_train = y[train_indices]
y_test = y[test_indices]

# Calculate training mean and standard deviation
X_mean = X_train.mean(axis=0)
X_std = X_train.std(axis=0)

# Avoid division by zero
X_std[X_std == 0] = 1

# Standardize features
X_train_scaled = (X_train - X_mean) / X_std
X_test_scaled = (X_test - X_mean) / X_std

print("Training samples:", len(X_train_scaled))
print("Testing samples:", len(X_test_scaled))
print("Number of features:", X_train_scaled.shape[1])

def euclidean_distance(x1, x2):
    return np.sqrt(np.sum((x1 - x2) ** 2))

print("Euclidean distance function created successfully.")

def knn_predict(X_train, y_train, X_test, k=5):
    predictions = []

    for x in X_test:

        distances = []

        for i in range(len(X_train)):
            distance = euclidean_distance(x, X_train[i])
            distances.append(distance)

        distances = np.array(distances)

        nearest_indices = np.argsort(distances)[:k]

        nearest_values = y_train[nearest_indices]

        prediction = np.mean(nearest_values)

        predictions.append(prediction)

    return np.array(predictions)

print("k-NN regression function created successfully.")

k = 5

y_pred = knn_predict(
    X_train_scaled,
    y_train,
    X_test_scaled,
    k
)

print("k =", k)
print("First 10 actual values:")
print(y_test[:10])

print("\nFirst 10 predicted values:")
print(y_pred[:10])

mae = np.mean(np.abs(y_test - y_pred))

mse = np.mean((y_test - y_pred) ** 2)

rmse = np.sqrt(mse)

print("k-NN Regression Performance")
print("---------------------------")
print("MAE :", mae)
print("MSE :", mse)
print("RMSE:", rmse)

# Calculate covariance matrix from training data
cov_matrix = np.cov(
    X_train_scaled,
    rowvar=False
)

print("Covariance matrix shape:", cov_matrix.shape)
print("\nCovariance matrix:")
print(cov_matrix)

cov_inverse = np.linalg.pinv(cov_matrix)

print("Inverse covariance matrix calculated successfully.")
print("\nInverse covariance matrix:")
print(cov_inverse)

def mahalanobis_distance(x1, x2, cov_inv):
    difference = x1 - x2

    distance = np.sqrt(
        difference.T @ cov_inv @ difference
    )

    return distance

print("Mahalanobis distance function created successfully.")

def knn_predict_mahalanobis(
    X_train,
    y_train,
    X_test,
    k,
    cov_inv
):
    predictions = []

    for x in X_test:

        distances = []

        for i in range(len(X_train)):

            distance = mahalanobis_distance(
                x,
                X_train[i],
                cov_inv
            )

            distances.append(distance)

        distances = np.array(distances)

        nearest_indices = np.argsort(distances)[:k]

        nearest_values = y_train[nearest_indices]

        prediction = np.mean(nearest_values)

        predictions.append(prediction)

    return np.array(predictions)

print("Mahalanobis k-NN function created successfully.")

k = 5

y_pred_mahalanobis = knn_predict_mahalanobis(
    X_train_scaled,
    y_train,
    X_test_scaled,
    k,
    cov_inverse
)

print("k =", k)

print("\nFirst 10 actual values:")
print(y_test[:10])

print("\nFirst 10 Mahalanobis predictions:")
print(y_pred_mahalanobis[:10])

mae_mahalanobis = np.mean(
    np.abs(y_test - y_pred_mahalanobis)
)

mse_mahalanobis = np.mean(
    (y_test - y_pred_mahalanobis) ** 2
)

rmse_mahalanobis = np.sqrt(
    mse_mahalanobis
)

print("Mahalanobis k-NN Performance")
print("----------------------------")
print("MAE :", mae_mahalanobis)
print("MSE :", mse_mahalanobis)
print("RMSE:", rmse_mahalanobis)

comparison = pd.DataFrame({
