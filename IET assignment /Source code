def prepare_regression_data(df):
    """
    Select climate features and crop yield as the target.

    Features are standardized manually using mean and standard
    deviation. No scikit-learn preprocessing is used.
    """
    feature_candidates = [
        "Temperature_C",
        "Humidity_%",
        "Rainfall_mm",
        "Wind_Speed_m_s",
        "Solar_Radiation_MJ_m2_day",
    ]

    available = [
        col for col in feature_candidates
        if col in df.columns
    ]

    if "Yield_kg_per_ha" not in df.columns:
        raise ValueError(
            "Yield_kg_per_ha column was not found."
        )

    if len(available) < 2:
        raise ValueError(
            "Not enough climate feature columns were found."
        )

    X = df[available].to_numpy(dtype=float)
    y = df["Yield_kg_per_ha"].to_numpy(dtype=float)

    means = X.mean(axis=0)
    stds = X.std(axis=0)
    stds[stds == 0] = 1.0

    X_scaled = (X - means) / stds

    return X_scaled, y, available


def train_test_split_manual(X, y, test_ratio=0.2, seed=42):
    """Manual randomized train/test split."""
    rng = np.random.default_rng(seed)
    indices = np.arange(len(X))
    rng.shuffle(indices)

    split = int(len(X) * (1 - test_ratio))

    train_idx = indices[:split]
    test_idx = indices[split:]

    return (
        X[train_idx],
        X[test_idx],
        y[train_idx],
        y[test_idx],
    )


