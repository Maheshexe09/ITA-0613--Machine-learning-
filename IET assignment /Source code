def save_scalability_plot(result):
    if result.empty:
        return

    plt.figure(figsize=(7, 5))
    plt.plot(
        result["Training_Size"],
        result["Runtime_Seconds"],
        marker="o",
    )

    plt.xlabel("Training Size")
    plt.ylabel("Prediction Runtime (seconds)")
    plt.title("k-NN Scalability")
    plt.tight_layout()

    plt.savefig(
        PLOTS_DIR / "scalability_runtime.png",
        dpi=200,
    )
    plt.close()


