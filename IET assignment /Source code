# EXPERIMENTS
# ============================================================

def run_knn_validation(X_train, X_test, y_train, y_test):
    rows = []

    for k in [1, 3, 5, 7, 9, 11]:
        model = KNNRegressor(k=k, metric="euclidean")
        model.fit(X_train, y_train)

        pred = model.predict(X_test)

        rows.append({
            "k": k,
            "MSE": mean_squared_error(y_test, pred),
            "MAE": mean_absolute_error(y_test, pred),
        })

    result = pd.DataFrame(rows)
    result.to_csv(
        TABLES_DIR / "knn_validation.csv",
        index=False,
    )

    return result


def run_knn_metric_comparison(X_train, X_test, y_train, y_test):
    rows = []

    for metric in ["euclidean", "mahalanobis"]:
        model = KNNRegressor(
            k=5,
            metric=metric,
        )
        model.fit(X_train, y_train)

        pred = model.predict(X_test)

        rows.append({
            "Metric": metric,
            "MSE": mean_squared_error(y_test, pred),
            "MAE": mean_absolute_error(y_test, pred),
        })

    result = pd.DataFrame(rows)

    result.to_csv(
        TABLES_DIR / "knn_metric_comparison.csv",
        index=False,
    )

    return result


def run_lwr_tau_comparison(
    X_train,
    X_test,
    y_train,
    y_test,
    sample_size=300,
):
    """
    Compare LWR bandwidth values.

    A sample is used because LWR solves a weighted linear system
    separately for each query point.
    """
    n = min(sample_size, len(X_test))

    rows = []

    for tau in [0.1, 0.5, 1.0, 2.0]:
        model = LocallyWeightedRegression(tau=tau)
        model.fit(X_train, y_train)

        pred = model.predict(X_test[:n])

        rows.append({
            "tau": tau,
            "MSE": mean_squared_error(
                y_test[:n],
                pred,
            ),
            "MAE": mean_absolute_error(
                y_test[:n],
                pred,
            ),
        })

    result = pd.DataFrame(rows)

    result.to_csv(
        TABLES_DIR / "lwr_tau_comparison.csv",
        index=False,
    )

    return result


def run_scalability_experiment(
    X_train,
    X_test,
    y_train,
    y_test,
):
    sizes = [
        500,
        1000,
        2000,
        5000,
        10000,
    ]

    rows = []

    for size in sizes:
        if size > len(X_train):
            continue

        model = KNNRegressor(k=5)
        model.fit(
            X_train[:size],
            y_train[:size],
        )

        start = time.perf_counter()
        pred = model.predict(
            X_test[:50]
        )
        elapsed = time.perf_counter() - start

        rows.append({
            "Training_Size": size,
            "Runtime_Seconds": elapsed,
            "MSE": mean_squared_error(
                y_test[:50],
                pred,
            ),
        })

    result = pd.DataFrame(rows)

    result.to_csv(
        TABLES_DIR / "scalability_results.csv",
        index=False,
    )

    return result


