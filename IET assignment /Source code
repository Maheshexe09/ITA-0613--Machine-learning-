def save_knn_actual_vs_predicted(
    y_true,
    y_pred,
):
    plt.figure(figsize=(7, 5))
    plt.scatter(y_true, y_pred, alpha=0.5)

    minimum = min(y_true.min(), y_pred.min())
    maximum = max(y_true.max(), y_pred.max())

    plt.plot(
        [minimum, maximum],
        [minimum, maximum],
        linestyle="--",
    )

    plt.xlabel("Actual Yield")
    plt.ylabel("Predicted Yield")
    plt.title("k-NN Actual vs Predicted Yield")
    plt.tight_layout()

    plt.savefig(
        PLOTS_DIR / "knn_actual_vs_predicted.png",
        dpi=200,
    )
    plt.close()


def save_yield_by_year(df):
    if not {"Year", "Yield_kg_per_ha"}.issubset(df.columns):
        return

    grouped = (
        df.groupby("Year")["Yield_kg_per_ha"]
        .mean()
    )

    plt.figure(figsize=(8, 5))
    plt.plot(grouped.index, grouped.values)
    plt.xlabel("Year")
    plt.ylabel("Average Yield")
    plt.title("Average Crop Yield by Year")
    plt.tight_layout()

    plt.savefig(
        PLOTS_DIR / "yield_by_year.png",
        dpi=200,
    )
    plt.close()


def save_yield_by_crop(df):
    if not {"Crop", "Yield_kg_per_ha"}.issubset(df.columns):
