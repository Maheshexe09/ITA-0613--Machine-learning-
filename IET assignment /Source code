    print(
        f"Training records: {len(X_train)}"
    )
    print(
        f"Testing records: {len(X_test)}"
    )

    # 3. k-NN validation
    print()
    print("Running k-NN validation...")
    knn_validation = run_knn_validation(
        X_train,
        X_test,
        y_train,
        y_test,
    )
    print(knn_validation.to_string(index=False))

    # 4. k-NN metric comparison
    print()
    print("Comparing distance metrics...")
    metric_result = run_knn_metric_comparison(
        X_train,
        X_test,
        y_train,
        y_test,
    )
    print(metric_result.to_string(index=False))

    # 5. k-NN prediction plot
    best_k = int(
        knn_validation.loc[
            knn_validation["MSE"].idxmin(),
            "k",
        ]
    )

    best_knn = KNNRegressor(
        k=best_k,
        metric="euclidean",
    )
    best_knn.fit(X_train, y_train)
    knn_pred = best_knn.predict(X_test)

    save_knn_actual_vs_predicted(
        y_test,
        knn_pred,
    )

    # 6. LWR
    print()
    print("Running LWR tau comparison...")
    lwr_result = run_lwr_tau_comparison(
        X_train,
        X_test,
        y_train,
        y_test,
    )
    print(lwr_result.to_string(index=False))

    # 7. Candidate Elimination demo
    print()
    print("Running Candidate-Elimination demo...")
    S, G = run_candidate_elimination_demo()

    print("Specific Boundary (S):")
    print(S)

    print("General Boundary (G):")
    for hypothesis in G:
        print(hypothesis)

    # 8. Scalability
    print()
    print("Running scalability experiment...")
    scalability_result = run_scalability_experiment(
        X_train,
        X_test,
        y_train,
        y_test,
    )
    print(scalability_result.to_string(index=False))

    # 9. Additional visualizations
    save_yield_by_year(df)
    save_yield_by_crop(df)
    save_top_states_yield(df)
    save_scalability_plot(scalability_result)

    print()
    print("Completed successfully.")
    print("Results directory:", RESULTS_DIR)
    print("Plots directory:", PLOTS_DIR)
    print("Tables directory:", TABLES_DIR)


if __name__ == "__main__":
    main()
