def mean_squared_error(y_true, y_pred):
    return float(np.mean((np.asarray(y_true) - np.asarray(y_pred)) ** 2))


def mean_absolute_error(y_true, y_pred):
    return float(np.mean(np.abs(np.asarray(y_true) - np.asarray(y_pred))))


# ============================================================
# k-NN REGRESSION FROM FIRST PRINCIPLES
# ============================================================

class KNNRegressor:
    def __init__(self, k=5, metric="euclidean"):
        if k < 1:
            raise ValueError("k must be at least 1")
        self.k = k
        self.metric = metric

    def fit(self, X, y):
        self.X_train = np.asarray(X, dtype=float)
        self.y_train = np.asarray(y, dtype=float)

        if len(self.X_train) < self.k:
            raise ValueError("k cannot be greater than training size")

        if self.metric == "mahalanobis":
            cov = np.cov(self.X_train, rowvar=False)
            cov = np.atleast_2d(cov)
            cov += np.eye(cov.shape[0]) * 1e-6
            self.inv_cov = np.linalg.pinv(cov)

        return self

    def _distance(self, x):
        diff = self.X_train - x

        if self.metric == "euclidean":
            return np.sqrt(np.sum(diff ** 2, axis=1))

        if self.metric == "mahalanobis":
            return np.sqrt(
                np.einsum(
                    "ij,jk,ik->i",
                    diff,
                    self.inv_cov,
                    diff,
                )
            )

        raise ValueError("Unknown distance metric")

    def predict(self, X):
        X = np.asarray(X, dtype=float)
        predictions = []

        for x in X:
            distances = self._distance(x)
            indices = np.argsort(distances)[:self.k]
            predictions.append(np.mean(self.y_train[indices]))

        return np.asarray(predictions)


# ============================================================
# LOCALLY WEIGHTED REGRESSION FROM FIRST PRINCIPLES
# ============================================================

class LocallyWeightedRegression:
    def __init__(self, tau=1.0):
        if tau <= 0:
            raise ValueError("tau must be greater than zero")
        self.tau = tau

    def fit(self, X, y):
        self.X_train = np.asarray(X, dtype=float)
        self.y_train = np.asarray(y, dtype=float)
        return self

    def predict(self, X):
        X = np.asarray(X, dtype=float)
        predictions = []

        X_train_bias = np.c_[
            np.ones(len(self.X_train)),
            self.X_train,
        ]

        for x in X:
            x_bias = np.r_[1, x]

            distances = np.sum(
                (self.X_train - x) ** 2,
                axis=1,
            )

            weights = np.exp(
                -distances / (2 * self.tau ** 2)
            )

            weighted_X = X_train_bias * weights[:, None]

            A = X_train_bias.T @ weighted_X
            b = X_train_bias.T @ (
                weights * self.y_train
            )

            theta = np.linalg.pinv(A) @ b
            predictions.append(x_bias @ theta)

        return np.asarray(predictions)


# ============================================================
# CANDIDATE ELIMINATION / VERSION SPACE
# ============================================================

class CandidateElimination:
    """
    Candidate-Elimination for categorical attributes.

    This algorithm is demonstrated on categorical examples.
    Continuous climate variables should be discretized before
    being used as hypothesis attributes.
    """

    def __init__(self, n_features, domains):
        self.n_features = n_features
        self.domains = domains
        self.S = ["Ø"] * n_features
        self.G = [["?"] * n_features]

    @staticmethod
    def covers(hypothesis, x):
        return all(
            h == "?" or h == value
            for h, value in zip(hypothesis, x)
        )

    def fit(self, X, y):
        X = np.asarray(X, dtype=str)

        for x, label in zip(X, y):
            if label == "High":
                self.update_positive(x)
            elif label == "Low":
                self.update_negative(x)

        return self

    def update_positive(self, x):
        if self.S[0] == "Ø":
            self.S = list(x)
        else:
            for i in range(self.n_features):
                if self.S[i] != x[i]:
                    self.S[i] = "?"

        self.G = [
            g for g in self.G
            if self.covers(g, x)
        ]

    def update_negative(self, x):
        new_G = []

        for g in self.G:
            if self.covers(g, x):
                for i in range(self.n_features):
                    if g[i] == "?":
                        for value in self.domains[i]:
                            if value != x[i]:
                                if (
                                    self.S[i] == "?"
                                    or value == self.S[i]
                                ):
                                    new_g = list(g)
                                    new_g[i] = value

                                    if new_g not in new_G:
                                        new_G.append(new_g)
            else:
                new_G.append(g)

        self.G = new_G

    def get_boundaries(self):
        return self.S, self.G


def create_risk_band(y):
    """Convert continuous target values into Low/Medium/High bands."""
    low = np.percentile(y, 33)
    high = np.percentile(y, 67)

    return np.where(
        y <= low,
        "Low",
        np.where(y >= high, "High", "Medium"),
    )


def run_candidate_elimination_demo():
    """
    Controlled categorical demonstration of Candidate Elimination.

    The controlled example is intentional because a simple
    categorical hypothesis space is not directly suitable for
    the raw continuous climate/yield values.
    """
    X = [
        ["High", "Medium"],
        ["High", "High"],
        ["Medium", "Medium"],
        ["Low", "Low"],
        ["Low", "Medium"],
    ]

    y = [
        "High",
        "Low",
        "Low",
        "Low",
        "Low",
    ]

    domains = [
        ["Low", "Medium", "High"],
        ["Low", "Medium", "High"],
    ]

    model = CandidateElimination(
        n_features=2,
        domains=domains,
    )

    model.fit(X, y)
    return model.get_boundaries()


