def load_data(file_path=DATASET_FILE):
    """Load the agro-climatic crop-yield dataset."""
    return pd.read_csv(file_path)


def clean_data(df):
    """Remove duplicates and handle numeric/weather missing values."""
    df = df.copy()
    df = df.drop_duplicates()

    numeric_cols = df.select_dtypes(include=np.number).columns
    df[numeric_cols] = df[numeric_cols].apply(
        pd.to_numeric, errors="coerce"
    )

    weather_cols = [
        "Temperature_C",
        "Humidity_%",
        "Rainfall_mm",
        "Wind_Speed_m_s",
        "Solar_Radiation_MJ_m2_day",
    ]

    for col in weather_cols:
        if col in df.columns and df[col].isnull().any():
            df[col] = df[col].fillna(df[col].median())

    return df


def engineer_features(df):
    """Create derived climate, nutrient and production features."""
    df = df.copy()

    if {"Temperature_C", "Rainfall_mm"}.issubset(df.columns):
        df["Temp_Rainfall_Index"] = (
            df["Temperature_C"] * df["Rainfall_mm"]
        )

    if {
        "N_req_kg_per_ha",
        "P_req_kg_per_ha",
        "K_req_kg_per_ha",
    }.issubset(df.columns):
        df["NPK_Index"] = (
            df["N_req_kg_per_ha"]
            + df["P_req_kg_per_ha"]
            + df["K_req_kg_per_ha"]
        )

    if {"Temperature_C", "Humidity_%"}.issubset(df.columns):
        df["Climate_Stress_Index"] = (
            df["Temperature_C"]
            * (1 - df["Humidity_%"] / 100)
        )

    if {"Area_ha", "Yield_kg_per_ha"}.issubset(df.columns):
        df["Production_Estimate_kg"] = (
            df["Area_ha"] * df["Yield_kg_per_ha"]
        )

    return df


def save_processed_data(df):
    """Save cleaned and engineered data."""
    output = DATASET_DIR / "clean_crop_yield.csv"
    df.to_csv(output, index=False)
    return output


